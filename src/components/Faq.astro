---
import { faqs, site } from '../data/site';
---

<section id="faq" class="bg-white py-20 lg:py-28">
  <div class="container-page grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
    <div>
      <p class="text-sm font-bold uppercase tracking-widest text-brand-600">FAQ</p>
      <h2 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl">
        Pertanyaan yang sering masuk
      </h2>
      <p class="mt-4 text-lg/8 text-ink-soft">
        Belum terjawab? Tim kami membalas di jam kerja, biasanya kurang dari satu jam.
      </p>
      <a
        href={site.whatsapp}
        class="mt-6 inline-flex rounded-full bg-brand-600 px-6 py-3 font-bold text-white transition-colors hover:bg-brand-700"
      >
        Tanya lewat WhatsApp
      </a>
    </div>

    <!-- name="faq" membuat hanya satu jawaban terbuka pada satu waktu. -->
    <div class="divide-y divide-brand-100 border-y border-brand-100">
      {
        faqs.map((faq) => (
          <details name="faq" class="group py-5">
            <summary class="flex cursor-pointer list-none items-start justify-between gap-6 font-bold">
              <span>{faq.q}</span>
              <span class="mt-1 grid size-6 shrink-0 place-items-center rounded-full bg-brand-50 text-brand-700 transition-transform group-open:rotate-45">
                <svg viewBox="0 0 24 24" class="size-3.5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true">
                  <path d="M12 5v14" />
                  <path d="M5 12h14" />
                </svg>
              </span>
            </summary>
            <p class="mt-3 max-w-2xl pr-12 text-sm/7 text-ink-soft">{faq.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
