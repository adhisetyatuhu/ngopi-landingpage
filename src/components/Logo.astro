---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

// Wordmark berupa raster (public/logo.png), 432×132 — tiga kali ukuran tampil
// agar tetap tajam di layar retina. Rasio dikunci lewat width/height supaya
// tidak ada pergeseran tata letak saat gambar selesai dimuat.
---

<a
  href="/"
  class:list={['inline-flex items-center', className]}
  aria-label="Ngopi — beranda"
>
  <img
    src="/logo.png"
    alt=""
    width="432"
    height="132"
    class="h-11 w-auto"
    decoding="async"
  />
</a>
