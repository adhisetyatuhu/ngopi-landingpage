---
import Icon from './Icon.astro';
import { features, wasteTypes } from '../data/site';
---

<section id="layanan" class="bg-white py-20 lg:py-28">
  <div class="container-page">
    <div class="max-w-2xl">
      <p class="text-sm font-bold uppercase tracking-widest text-brand-600">Layanan</p>
      <h2 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl">
        Dibuat untuk yang capek menunggu tukang sampah
      </h2>
      <p class="mt-4 text-lg/8 text-ink-soft">
        Dari rumah tangga sampai instansi dengan puluhan titik penjemputan — satu aplikasi,
        satu catatan, satu tagihan.
      </p>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        features.map((feature) => (
          <article class="reveal group rounded-3xl border border-brand-100 p-6 transition-colors hover:border-brand-300 hover:bg-brand-50/40">
            <span class="grid size-12 place-items-center rounded-2xl bg-brand-600 text-white transition-transform group-hover:-rotate-6">
              <Icon name={feature.icon} />
            </span>
            <h3 class="mt-5 text-lg font-bold">{feature.title}</h3>
            <p class="mt-2 text-sm/7 text-ink-soft">{feature.body}</p>
          </article>
        ))
      }
    </div>

    <div class="mt-16 rounded-4xl bg-ink p-8 text-white sm:p-12">
      <div class="grid gap-10 lg:grid-cols-[1fr_1.4fr] lg:items-center">
        <div>
          <h3 class="text-2xl font-extrabold tracking-tight sm:text-3xl">
            Jenis sampah yang kami angkut
          </h3>
          <p class="mt-3 text-white/70">
            Punya jenis lain? Kirimkan fotonya lewat aplikasi dan kami balas dengan estimasi
            biayanya.
          </p>
        </div>

        <ul class="grid gap-x-8 gap-y-5 sm:grid-cols-2">
          {
            wasteTypes.map((type) => (
              <li class="flex gap-3">
                <span class="mt-0.5 grid size-6 shrink-0 place-items-center rounded-full bg-brand-500/20 text-brand-300">
                  <Icon name="check" class="size-3.5" />
                </span>
                <div>
                  <p class="font-semibold">{type.title}</p>
                  <p class="text-sm text-white/60">{type.body}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
