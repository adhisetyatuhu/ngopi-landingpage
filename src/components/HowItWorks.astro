---
import Icon from './Icon.astro';
import { steps } from '../data/site';
---

<section id="cara-kerja" class="py-20 lg:py-28">
  <div class="container-page">
    <div class="max-w-2xl">
      <p class="text-sm font-bold uppercase tracking-widest text-brand-600">Cara kerja</p>
      <h2 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl">
        Empat langkah, sampah beres sampai tuntas
      </h2>
      <p class="mt-4 text-lg/8 text-ink-soft">
        Tidak ada telepon-teleponan, tidak ada tawar-menawar di depan pagar. Semuanya berjalan
        dari aplikasi.
      </p>
    </div>

    <ol class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        steps.map((step, i) => (
          <li class="reveal relative rounded-3xl border border-brand-100 bg-white p-6 shadow-sm">
            <span class="grid size-12 place-items-center rounded-2xl bg-brand-50 text-brand-600">
              <Icon name={step.icon} />
            </span>
            <span class="absolute right-6 top-6 text-3xl font-extrabold text-brand-100">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-5 text-lg font-bold">{step.title}</h3>
            <p class="mt-2 text-sm/7 text-ink-soft">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
