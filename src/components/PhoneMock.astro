---
/**
 * Mockup layar aplikasi, dibuat murni dengan markup agar tetap tajam di
 * layar apa pun dan mudah diganti bila desain aplikasi berubah.
 */
import Icon from './Icon.astro';
---

<div class="relative mx-auto w-[17.5rem] sm:w-[19rem]">
  <div class="rounded-[2.75rem] border-[10px] border-ink bg-ink shadow-2xl shadow-ink/30">
    <div class="relative overflow-hidden rounded-[2.1rem] bg-cream">
      <div
        class="absolute left-1/2 top-2 z-10 h-5 w-24 -translate-x-1/2 rounded-full bg-ink"
        aria-hidden="true"
      >
      </div>

      <div class="bg-linear-to-b from-brand-600 to-brand-500 px-5 pb-8 pt-11 text-white">
        <p class="text-xs/5 opacity-80">Selamat pagi,</p>
        <p class="text-lg font-bold">Mister X</p>

        <div class="mt-4 rounded-2xl bg-white/15 p-3 backdrop-blur-sm">
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold opacity-90">Paket Medium</span>
            <span class="rounded-full bg-white/25 px-2 py-0.5 text-[0.6rem] font-bold">AKTIF</span>
          </div>
          <p class="mt-1 text-xs opacity-80">Sisa 7 dari 12 penjemputan bulan ini</p>
          <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-white/25">
            <div class="h-full w-[58%] rounded-full bg-white"></div>
          </div>
        </div>
      </div>

      <div class="-mt-4 space-y-3 rounded-t-3xl bg-cream px-4 pb-6 pt-5">
        <div class="rounded-2xl border border-brand-100 bg-white p-3 shadow-sm">
          <div class="flex items-center gap-2.5">
            <span class="grid size-9 shrink-0 place-items-center rounded-full bg-brand-50 text-brand-600">
              <Icon name="truck" class="size-5" />
            </span>
            <div class="min-w-0">
              <p class="text-xs font-bold text-ink">Petugas dalam perjalanan</p>
              <p class="truncate text-[0.7rem] text-ink-soft">Tiba sekitar 08.20 · Slot pagi</p>
            </div>
          </div>
          <div class="mt-2.5 flex items-center gap-1.5" aria-hidden="true">
            <span class="h-1 flex-1 rounded-full bg-brand-500"></span>
            <span class="h-1 flex-1 rounded-full bg-brand-500"></span>
            <span class="h-1 flex-1 rounded-full bg-brand-100"></span>
            <span class="h-1 flex-1 rounded-full bg-brand-100"></span>
          </div>
        </div>

        <div class="rounded-2xl border border-brand-100 bg-white p-3 shadow-sm">
          <p class="text-[0.7rem] font-semibold text-ink-soft">Penjemputan terakhir</p>
          <div class="mt-1.5 flex items-baseline justify-between">
            <span class="text-xl font-extrabold text-ink">24,5 kg</span>
            <span class="text-xs font-bold text-brand-600">Rp 36.750</span>
          </div>
          <p class="mt-1 text-[0.7rem] text-ink-soft">Rabu, 6 Agu · Selesai 08.34</p>
        </div>

        <div class="flex gap-2">
          <div class="flex-1 rounded-2xl bg-ink p-3 text-white">
            <Icon name="calendar" class="size-4" />
            <p class="mt-1.5 text-[0.7rem] font-bold leading-tight">Atur jadwal</p>
          </div>
          <div class="flex-1 rounded-2xl bg-bean-100 p-3 text-bean-700">
            <Icon name="receipt" class="size-4" />
            <p class="mt-1.5 text-[0.7rem] font-bold leading-tight">Lihat tagihan</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Kartu mengambang, dekoratif saja. -->
  <div
    class="absolute -left-6 top-1/3 hidden rounded-2xl bg-white p-3 shadow-xl shadow-black/10 sm:block"
    aria-hidden="true"
  >
    <div class="flex items-center gap-2">
      <span class="grid size-8 place-items-center rounded-full bg-brand-50 text-brand-600">
        <Icon name="check" class="size-4" />
      </span>
      <div>
        <p class="text-[0.7rem] font-bold leading-tight text-ink">Sampah terangkut</p>
        <p class="text-[0.65rem] text-ink-soft">Bukti foto tersimpan</p>
      </div>
    </div>
  </div>

  <div
    class="absolute -right-4 bottom-24 hidden rounded-2xl bg-white p-3 shadow-xl shadow-black/10 sm:block"
    aria-hidden="true"
  >
    <p class="text-[0.65rem] font-semibold text-ink-soft">Bulan ini</p>
    <p class="text-base font-extrabold text-ink">98,2 kg</p>
    <p class="text-[0.65rem] font-semibold text-brand-600">Terpilah 71%</p>
  </div>
</div>
