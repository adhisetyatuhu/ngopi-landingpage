---
import Icon from './Icon.astro';
import { coverage, site } from '../data/site';
---

<section id="area" class="bg-white py-20 lg:py-28">
  <div class="container-page grid gap-12 lg:grid-cols-2 lg:items-center">
    <div>
      <p class="text-sm font-bold uppercase tracking-widest text-brand-600">Area layanan</p>
      <h2 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl">
        Sudah beroperasi di {coverage.length} area di Cililitan
      </h2>
      <p class="mt-4 text-lg/8 text-ink-soft">
        Masukkan alamat Anda di aplikasi untuk memastikan titik penjemputan sudah tercakup.
        Belum ada di area Anda? Beri tahu kami — daftar area terus bertambah.
      </p>

      <ul class="mt-8 flex flex-wrap gap-2.5">
        {
          coverage.map((city) => (
            <li class="inline-flex items-center gap-1.5 rounded-full border border-brand-100 bg-brand-50/60 px-4 py-2 text-sm font-semibold text-brand-700">
              <Icon name="pin" class="size-4" />
              {city}
            </li>
          ))
        }
      </ul>

      <a
        href={site.whatsapp}
        class="mt-8 inline-flex items-center gap-2 font-bold text-brand-700 underline underline-offset-4"
      >
        Usulkan area tempat tinggal Anda
        <Icon name="arrow" class="size-4" />
      </a>
    </div>

    <div class="reveal relative overflow-hidden rounded-4xl bg-brand-50 p-8 sm:p-10">
      <div class="grid gap-4 sm:grid-cols-2">
        <div class="rounded-3xl bg-white p-5 shadow-sm">
          <span class="grid size-11 place-items-center rounded-2xl bg-brand-600 text-white">
            <Icon name="clock" class="size-5" />
          </span>
          <p class="mt-4 text-2xl font-extrabold">3 slot</p>
          <p class="mt-1 text-sm text-ink-soft">
            Pagi 07.00–11.00, siang 11.00–15.00, sore 15.00–18.00.
          </p>
        </div>

        <div class="rounded-3xl bg-white p-5 shadow-sm sm:mt-8">
          <span class="grid size-11 place-items-center rounded-2xl bg-bean-500 text-white">
            <Icon name="truck" class="size-5" />
          </span>
          <p class="mt-4 text-2xl font-extrabold">H+1</p>
          <p class="mt-1 text-sm text-ink-soft">
            Permintaan di luar jadwal dijemput paling cepat keesokan harinya.
          </p>
        </div>

        <div class="rounded-3xl bg-white p-5 shadow-sm">
          <span class="grid size-11 place-items-center rounded-2xl bg-ink text-white">
            <Icon name="recycle" class="size-5" />
          </span>
          <p class="mt-4 text-2xl font-extrabold">71%</p>
          <p class="mt-1 text-sm text-ink-soft">
            Rata-rata sampah pelanggan kami yang berhasil dipilah dan didaur ulang.
          </p>
        </div>

        <div class="rounded-3xl bg-white p-5 shadow-sm sm:mt-8">
          <span class="grid size-11 place-items-center rounded-2xl bg-brand-500 text-white">
            <Icon name="scale" class="size-5" />
          </span>
          <p class="mt-4 text-2xl font-extrabold">kg & m³</p>
          <p class="mt-1 text-sm text-ink-soft">
            Dua satuan penimbangan, dipilih otomatis sesuai jenis sampah.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
